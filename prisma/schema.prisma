// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                  @id @default(cuid())
  phoneNumber           String                  @unique
  phoneVerification     PhoneVerificationMethod @default(NONE)
  phoneVerifiedAt       DateTime?

  googleAccountId       String?                 @unique
  googleEmail           String?

  displayName           String
  pushToken             String?

  lastSeenAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  sessions              Session[]

  outgoingCalls         Call[]                  @relation("OutgoingCalls")
  incomingCalls         Call[]                  @relation("IncomingCalls")
}

enum PhoneVerificationMethod {
  NONE
  SIM
  SMS
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Call {
  id         String   @id @default(cuid())

  callerId   String
  receiverId String

  status     CallStatus @default(RINGING)

  createdAt  DateTime @default(now())
  startedAt DateTime?
  answeredAt DateTime?
  endedAt    DateTime?

  caller     User @relation("OutgoingCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver   User @relation("IncomingCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
}

enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
}